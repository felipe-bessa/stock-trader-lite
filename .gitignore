.env.*.local

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.sublime-project

# --- Build & Output ---
# For future production builds
dist/
build/
.cache/

# --- Persistence (Local Development) ---
# If you use any local DB files for testing
*.db
*.sqlite